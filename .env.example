# =====================================================================
# AI VIDEO AUTOMATION - ENVIRONMENT TEMPLATE (.env.example)
# =====================================================================

# ---------------------------------------------------------------------
# 1. AI SCRIPT GENERATOR (Multi-Key Rotation & Zero-Failure Failover)
# ---------------------------------------------------------------------
# Add one or more Gemini API Keys (comma-separated) from: https://aistudio.google.com/app/apikey
# If Key #1 hits quota (HTTP 429), it automatically rotates to Key #2, Key #3, etc.
# If all keys run out of quota, it automatically falls back to the built-in procedural tech generator.
# Video production is 100% guaranteed never to fail.
GEMINI_API_KEYS=YOUR_FIRST_GEMINI_KEY,YOUR_SECOND_GEMINI_KEY,YOUR_THIRD_GEMINI_KEY
GEMINI_API_KEY=YOUR_FIRST_GEMINI_KEY

# ---------------------------------------------------------------------
# 1B. FREELLMAPI GATEWAY (https://github.com/tashfeenahmed/freellmapi)
# ---------------------------------------------------------------------
# Aggregates 87 Free LLM Providers (10.1 Billion free tokens/month)
# (Google Gemini, Groq, Cerebras, Mistral, NVIDIA, DeepSeek, HuggingFace, etc.)
# Local Docker/Node URL: http://localhost:3001/v1 or https://freellmapi.co/v1
FREELLMAPI_ENABLED=false
FREELLMAPI_BASE_URL=http://localhost:3001/v1
FREELLMAPI_API_KEY=your-freellmapi-unified-token
FREELLMAPI_MODEL=auto

# ---------------------------------------------------------------------
# 2. SMART BEST-TIME SCHEDULING (Differentiated UTC vs IST Timings)
# ---------------------------------------------------------------------
# Maximum videos to post per day (Strict Daily Cap Safeguard: Max 2 videos/day)
# Dual-track: Exactly 1 Frontier AI drop + 1 Offensive Cybersecurity drop per day
MAX_VIDEOS_PER_DAY=2

# SCHEDULE_MODE: "best_times" (recommended for peak reach) or "interval"
SCHEDULE_MODE=best_times
BEST_POST_TIMES=13:00,20:00
TIMEZONE=Asia/Kolkata

# YOUTUBE SHORTS TIMING (UTC Best Timings - Global Tech Audience)
# Peak global developer / tech windows:
# 15:00 UTC = 10:00 AM EST (US morning) / 3:00 PM UK / 8:30 PM IST
# 20:00 UTC = 3:00 PM EST (US afternoon peak) / 8:00 PM UK / 1:30 AM IST
YOUTUBE_POST_TIMES_UTC=15:00,20:00
YOUTUBE_SCHEDULE_MODE=scheduled

# INSTAGRAM REELS & FACEBOOK TIMING (IST Best Timings - Indian Audience)
# Peak Indian engagement windows (Hindi Voice + Hinglish Captions):
# 13:00 IST = Lunch break mobile browsing peak (07:30 UTC)
# 20:00 IST = Prime time evening leisure scroll (14:30 UTC)
INSTAGRAM_FB_POST_TIMES_IST=13:00,20:00
INSTAGRAM_FB_SCHEDULE_MODE=best_times

# ---------------------------------------------------------------------
# 3. VOICE & TYPOGRAPHY DYNAMIC ROTATION (Never Same Voice/Font Everyday)
# ---------------------------------------------------------------------
# When set to true, the pipeline automatically rotates across 7 curated studio voices,
# 5 top viral fonts (Anton, Impact, Bebas Neue, Archivo Black, Arial Black), and dynamic
# kinetic highlight colors (Yellow, Cyan, Neon Green, Orange, Magenta, Gold).
# Every day of the week and consecutive videos on the same day use a fresh combination!
ROTATE_STYLES=true

# Fallback voice settings (used only if ROTATE_STYLES is set to false):
VOICE_NAME=en-US-ChristopherNeural
VOICE_RATE=+15%
VOICE_PITCH=+0Hz

# ---------------------------------------------------------------------
# 4. CONTENT TOPICS & NICHE RESEARCH
# ---------------------------------------------------------------------
TARGET_TOPICS=Cybersecurity,Web Penetration Testing,Zero-Day Exploits,Bug Bounty,Malware Analysis,Ethical Hacking,Tech News
FETCH_INTERVAL_MINUTES=180
AUTO_GENERATE_COUNT=1

# ---------------------------------------------------------------------
# 5. FREE UNLIMITED CLOUD STORAGE (Telegram Bot API)
# ---------------------------------------------------------------------
# Telegram channels provide 100% free unlimited storage (up to 2GB per video).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------
# 6. YOUTUBE STUDIO AUTO-UPLOAD (YouTube Data API v3)
# ---------------------------------------------------------------------
CHANNEL_NAME=The Spy
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json
YOUTUBE_TOKEN_FILE=token.json
YOUTUBE_PRIVACY_STATUS=public
YOUTUBE_CATEGORY_ID=28
YOUTUBE_AUTO_UPLOAD=true

# ---------------------------------------------------------------------
# 7. INSTAGRAM REELS (Meta Graph API or instagrapi)
# ---------------------------------------------------------------------
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
INSTAGRAM_AUTO_POST=false

# ---------------------------------------------------------------------
# 8. FACEBOOK PAGE REELS (Meta Graph API)
# ---------------------------------------------------------------------
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_AUTO_POST=false

# ---------------------------------------------------------------------
# 9. GOOGLE SPREADSHEET SYNC
# ---------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_FILE=google_sheets_creds.json
GOOGLE_SHEET_NAME=AI Video Automation Logs
GOOGLE_SHEET_WEBHOOK_URL=

# ---------------------------------------------------------------------
# 10. DISCORD WEBHOOK NOTIFICATION ALERTS
# ---------------------------------------------------------------------
# Create a webhook in your Discord channel (Edit Channel -> Integrations -> Webhooks)
DISCORD_WEBHOOK_URL=

# ---------------------------------------------------------------------
# 11. VPS & DASHBOARD SETTINGS
# ---------------------------------------------------------------------
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
DASHBOARD_SECRET_KEY=change-me-to-a-random-secret
CONCURRENT_WORKERS=2
